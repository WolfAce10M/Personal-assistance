---
export const prerender = false;

import '../../styles/global.css';
import { listBookings } from '../../lib/bookings';
import { findItem, fmtTime } from '../../data/booking';
import { hasDb } from '../../lib/server';

const url = new URL(Astro.request.url);
const status = url.searchParams.get('status') ?? 'active';
const today = new Date().toISOString().slice(0, 10);

// 'active' = próximas no canceladas; el resto filtra por estado o todas
const rows = await listBookings({
  from: status === 'all' || status === 'past' ? undefined : today,
  status: status === 'active' ? undefined : status === 'all' || status === 'past' ? undefined : status,
});

const filtered = rows.filter((b: any) => {
  if (status === 'active') return b.status !== 'cancelled' && b.status !== 'expired' && b.day >= today;
  if (status === 'past') return b.day < today;
  if (status === 'all') return true;
  return b.status === status;
});

const money = (n: number) => `${Number(n).toFixed(0)} €`;
const nameOf = (b: any) => findItem(b.type, b.item_id)?.name ?? b.item_id;

const confirmedUpcoming = rows.filter((b: any) => b.status === 'confirmed' && b.day >= today);
const revenue = confirmedUpcoming.reduce((s: number, b: any) => s + Number(b.total_eur), 0);

const statusLabel: Record<string, string> = {
  confirmed: 'Confirmada', pending: 'Pendiente pago', cancelled: 'Cancelada', expired: 'Caducada',
};
const statusColor: Record<string, string> = {
  confirmed: 'bg-green-500/15 text-green-400',
  pending: 'bg-yellow-500/15 text-yellow-300',
  cancelled: 'bg-red-500/15 text-red-300',
  expired: 'bg-white/10 text-white/50',
};
const tabs = [
  { id: 'active', label: 'Próximas' },
  { id: 'confirmed', label: 'Confirmadas' },
  { id: 'pending', label: 'Pendientes' },
  { id: 'cancelled', label: 'Canceladas' },
  { id: 'past', label: 'Pasadas' },
  { id: 'all', label: 'Todas' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel de reservas · Costa Brava Rent Jet Ski</title>
  </head>
  <body class="min-h-screen bg-ink-950 text-white">
    <header class="border-b border-white/10 bg-ink-900/60 sticky top-0 z-10 backdrop-blur">
      <div class="container-x flex items-center justify-between h-16">
        <div>
          <h1 class="font-display font-bold text-lg leading-none">Panel de reservas</h1>
          <p class="text-xs text-white/40">Costa Brava Rent Jet Ski</p>
        </div>
        <a href="/" class="text-sm text-white/60 hover:text-brand-orange transition-colors">← Ver web</a>
      </div>
    </header>

    <main class="container-x py-8">
      {!hasDb() && (
        <div class="rounded-2xl border border-yellow-500/30 bg-yellow-500/10 p-4 text-sm text-yellow-200 mb-6">
          La base de datos (Supabase) no está conectada, así que no hay reservas que mostrar.
          Revisa las variables <b>SUPABASE_URL</b> y <b>SUPABASE_SERVICE_ROLE_KEY</b> en Vercel.
        </div>
      )}

      <!-- Resumen -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
        <div class="rounded-2xl border border-white/10 bg-ink-850/60 p-4">
          <span class="block text-3xl font-display font-bold text-brand-orange">{confirmedUpcoming.length}</span>
          <span class="text-xs uppercase tracking-wider text-white/40">Reservas confirmadas próximas</span>
        </div>
        <div class="rounded-2xl border border-white/10 bg-ink-850/60 p-4">
          <span class="block text-3xl font-display font-bold">{money(revenue)}</span>
          <span class="text-xs uppercase tracking-wider text-white/40">Ingresos confirmados próximos</span>
        </div>
        <div class="rounded-2xl border border-white/10 bg-ink-850/60 p-4">
          <span class="block text-3xl font-display font-bold">{filtered.length}</span>
          <span class="text-xs uppercase tracking-wider text-white/40">Mostradas</span>
        </div>
      </div>

      <!-- Filtros -->
      <div class="flex flex-wrap gap-2 mb-5">
        {tabs.map((tb) => (
          <a
            href={`/admin?status=${tb.id}`}
            class={`rounded-full px-4 py-2 text-sm font-medium border transition-colors ${
              status === tb.id ? 'border-brand-orange text-brand-orange bg-brand-orange/10' : 'border-white/12 text-white/70 hover:text-white'
            }`}
          >
            {tb.label}
          </a>
        ))}
      </div>

      {filtered.length === 0 ? (
        <p class="text-white/50 py-12 text-center">No hay reservas en esta vista.</p>
      ) : (
        <div class="space-y-3">
          {filtered.map((b: any) => (
            <div class="rounded-2xl border border-white/10 bg-ink-850/60 p-4 grid gap-3 sm:grid-cols-[auto_1fr_auto] sm:items-center">
              <div class="flex sm:flex-col items-center sm:items-start gap-2">
                <span class="text-lg font-display font-bold">{b.day}</span>
                <span class="text-brand-sand font-semibold">{fmtTime(b.start_min)}</span>
              </div>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-bold">{nameOf(b)}</span>
                  <span class={`rounded-full px-2 py-0.5 text-[11px] font-semibold ${statusColor[b.status] ?? ''}`}>
                    {statusLabel[b.status] ?? b.status}
                  </span>
                  <span class="text-xs text-white/40">{b.type === 'route' ? 'Ruta' : 'Con licencia'}</span>
                </div>
                <div class="mt-1 text-sm text-white/70">
                  {b.qty} moto(s) · {money(b.total_eur)} · {b.season === 'low' ? 'T. baja' : 'T. alta'}
                </div>
                <div class="mt-1 text-sm text-white/55">
                  <b class="text-white/80">{b.customer_name}</b> · {b.customer_phone} · {b.customer_email}
                  {b.notes ? <span class="block text-white/40 italic mt-0.5">“{b.notes}”</span> : null}
                </div>
              </div>
              <div class="flex sm:flex-col gap-2 justify-end">
                <a href={`https://wa.me/${String(b.customer_phone).replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener noreferrer"
                   class="rounded-full bg-white/8 px-4 py-2 text-sm font-semibold text-center hover:bg-white/15 transition-colors">WhatsApp</a>
                {b.status !== 'cancelled' && (
                  <button data-cancel={b.id} type="button"
                    class="rounded-full bg-red-500/15 text-red-300 px-4 py-2 text-sm font-semibold hover:bg-red-500/25 transition-colors">
                    Cancelar
                  </button>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
    </main>

    <script is:inline>
      document.querySelectorAll('[data-cancel]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (!confirm('¿Cancelar esta reserva? Se liberará el hueco.')) return;
          btn.disabled = true;
          btn.textContent = 'Cancelando…';
          try {
            const res = await fetch('/api/admin/cancel', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: btn.getAttribute('data-cancel') }),
            });
            if (res.ok) location.reload();
            else { btn.disabled = false; btn.textContent = 'Error, reintentar'; }
          } catch {
            btn.disabled = false; btn.textContent = 'Error, reintentar';
          }
        });
      });
    </script>
  </body>
</html>
