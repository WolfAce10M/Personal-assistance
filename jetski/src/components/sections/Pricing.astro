---
import Icon from '../ui/Icon.astro';
import { useTranslations, type Lang } from '../../i18n/utils';
import { FLEET, DEPOSIT_LICENSE } from '../../data/fleet';
import { ROUTES, DEPOSIT_NO_LICENSE } from '../../data/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Filas "con licencia": una por (modelo × duración)
const licenseRows = FLEET.flatMap((j) =>
  j.prices.map((p) => ({
    model: j.model,
    power: j.power,
    minutes: p.minutes,
    low: p.low,
    high: p.high,
    fuel: p.fuelIncluded,
  }))
);
---

<section id="precios" class="relative py-24 md:py-32 scroll-mt-20 bg-ink-900/50">
  <div class="container-x">
    <div class="max-w-2xl">
      <span data-reveal class="inline-block text-sm font-semibold uppercase tracking-widest text-brand-orange">
        {t('pricing.kicker')}
      </span>
      <h2 data-reveal data-reveal-delay="0.05" class="mt-4 text-4xl md:text-5xl lg:text-6xl font-black text-white">
        {t('pricing.title')}
      </h2>
      <p data-reveal data-reveal-delay="0.1" class="mt-5 text-lg text-white/70 leading-relaxed">
        {t('pricing.subtitle')}
      </p>
    </div>

    <div class="mt-12 grid lg:grid-cols-2 gap-6">
      <!-- CON LICENCIA -->
      <div data-reveal class="rounded-3xl border border-white/8 bg-ink-850/60 overflow-hidden">
        <div class="flex items-center justify-between gap-3 p-5 border-b border-white/8">
          <h3 class="text-lg font-bold text-white">{t('pricing.license')}</h3>
          <span class="rounded-full bg-white/8 px-3 py-1 text-xs text-brand-sand-soft">
            {t('fleet.deposit')} {DEPOSIT_LICENSE}€
          </span>
        </div>
        <div class="overflow-x-auto no-scrollbar">
          <table class="w-full text-sm min-w-[30rem]">
            <thead>
              <tr class="text-left text-[11px] uppercase tracking-wider text-white/40">
                <th class="px-5 py-3 font-medium">{t('pricing.model')}</th>
                <th class="px-3 py-3 font-medium">{t('pricing.duration')}</th>
                <th class="px-3 py-3 font-medium text-right">{t('pricing.low')}</th>
                <th class="px-3 py-3 font-medium text-right">{t('pricing.high')}</th>
                <th class="px-5 py-3 font-medium text-center">{t('pricing.fuel')}</th>
              </tr>
            </thead>
            <tbody>
              {
                licenseRows.map((r, i) => (
                  <tr class={`border-t border-white/5 ${i % 2 ? '' : 'bg-white/[0.015]'}`}>
                    <td class="px-5 py-3">
                      <span class="font-semibold text-white">{r.model}</span>
                      <span class="block text-[11px] text-brand-orange/80">{r.power} CV</span>
                    </td>
                    <td class="px-3 py-3 text-white/70 whitespace-nowrap">{r.minutes}′</td>
                    <td class="px-3 py-3 text-right text-white/80">{r.low}€</td>
                    <td class="px-3 py-3 text-right font-semibold text-white">{r.high}€</td>
                    <td class="px-5 py-3 text-center">
                      {r.fuel ? (
                        <Icon name="check" class="inline w-4 h-4 text-green-400" />
                      ) : (
                        <span class="text-white/30 text-xs">{t('pricing.fuel.no')}</span>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- SIN LICENCIA (rutas) -->
      <div data-reveal data-reveal-delay="0.08" class="rounded-3xl border border-white/8 bg-ink-850/60 overflow-hidden">
        <div class="flex items-center justify-between gap-3 p-5 border-b border-white/8">
          <h3 class="text-lg font-bold text-white">{t('pricing.nolicense')}</h3>
          <span class="rounded-full bg-white/8 px-3 py-1 text-xs text-brand-sand-soft">
            {t('fleet.deposit')} {DEPOSIT_NO_LICENSE}€
          </span>
        </div>
        <div class="overflow-x-auto no-scrollbar">
          <table class="w-full text-sm min-w-[28rem]">
            <thead>
              <tr class="text-left text-[11px] uppercase tracking-wider text-white/40">
                <th class="px-5 py-3 font-medium">{t('pricing.route')}</th>
                <th class="px-3 py-3 font-medium">{t('pricing.duration')}</th>
                <th class="px-3 py-3 font-medium text-right">{t('pricing.low')}</th>
                <th class="px-3 py-3 font-medium text-right">{t('pricing.high')}</th>
                <th class="px-5 py-3 font-medium text-center">{t('pricing.fuel')}</th>
              </tr>
            </thead>
            <tbody>
              {
                ROUTES.map((r, i) => (
                  <tr class={`border-t border-white/5 ${i % 2 ? '' : 'bg-white/[0.015]'}`}>
                    <td class="px-5 py-3 font-semibold text-white">{r.name}</td>
                    <td class="px-3 py-3 text-white/70 whitespace-nowrap">{r.minutes}′</td>
                    <td class="px-3 py-3 text-right text-white/80">{r.low}€</td>
                    <td class="px-3 py-3 text-right font-semibold text-white">{r.high}€</td>
                    <td class="px-5 py-3 text-center">
                      <Icon name="check" class="inline w-4 h-4 text-green-400" />
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Notas -->
    <div data-reveal class="mt-6 flex flex-col sm:flex-row sm:items-center gap-x-6 gap-y-2 text-xs text-white/45">
      <span class="inline-flex items-center gap-1.5">
        <Icon name="shield" class="w-4 h-4 text-brand-sand/70" />
        {t('pricing.deposit.license')}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon name="shield" class="w-4 h-4 text-brand-sand/70" />
        {t('pricing.deposit.nolicense')}
      </span>
    </div>
    <p data-reveal class="mt-2 text-xs text-white/40">{t('pricing.season.note')}</p>
  </div>
</section>
