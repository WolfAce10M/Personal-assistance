---
import Icon from '../ui/Icon.astro';
import { useTranslations, type Lang } from '../../i18n/utils';
import { SITE } from '../../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const faqs = [
  { q: t('faq.q1'), a: t('faq.a1') },
  { q: t('faq.q2'), a: t('faq.a2') },
  { q: t('faq.q3'), a: t('faq.a3') },
  { q: t('faq.q4'), a: t('faq.a4') },
  { q: t('faq.q5'), a: t('faq.a5') },
  { q: t('faq.q6'), a: t('faq.a6') },
];

// Datos estructurados FAQ para SEO
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="faq" class="relative py-24 md:py-32 scroll-mt-20">
  <div class="container-x">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-16">
      <div>
        <span data-reveal class="inline-block text-sm font-semibold uppercase tracking-widest text-brand-orange">
          {t('faq.kicker')}
        </span>
        <h2 data-reveal data-reveal-delay="0.05" class="mt-4 text-4xl md:text-5xl font-black text-white">
          {t('faq.title')}
        </h2>
        <p data-reveal data-reveal-delay="0.1" class="mt-6 text-white/60 leading-relaxed">
          {t('footer.hours.note')}
        </p>
        <a
          data-reveal
          href={`tel:${SITE.phonePrimary}`}
          class="mt-4 inline-flex items-center gap-2 text-brand-orange font-semibold hover:text-brand-orange-bright transition-colors"
        >
          <Icon name="phone" class="w-4 h-4" />
          {SITE.phonePrimaryDisplay}
        </a>
      </div>

      <div class="flex flex-col gap-3">
        {
          faqs.map((f, i) => (
            <details
              data-reveal
              data-reveal-delay={String(i * 0.04)}
              class="group rounded-2xl border border-white/8 bg-ink-850/60 open:bg-ink-800/70 open:border-brand-orange/30 transition-colors"
            >
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 list-none">
                <span class="font-semibold text-white">{f.q}</span>
                <Icon name="chevron" class="w-5 h-5 shrink-0 text-brand-orange transition-transform duration-300 group-open:rotate-180" />
              </summary>
              <div class="px-5 pb-5 -mt-1 text-sm text-white/65 leading-relaxed">{f.a}</div>
            </details>
          ))
        }
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
