---
import Icon from '../ui/Icon.astro';
import { useTranslations, type Lang } from '../../i18n/utils';
import { whatsappLink } from '../../data/site';
import { FLEET, type JetSki } from '../../data/fleet';
import type { UIKey } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const fromPrice = (j: JetSki) => Math.min(...j.prices.map((p) => p.low));
---

<section id="flota" class="relative py-24 md:py-32 scroll-mt-20 overflow-hidden">
  <!-- Glow de fondo -->
  <div class="pointer-events-none absolute -top-40 right-0 h-[40rem] w-[40rem] rounded-full bg-brand-orange/8 blur-[120px]"></div>

  <div class="container-x relative">
    <div class="max-w-2xl">
      <span data-reveal class="inline-block text-sm font-semibold uppercase tracking-widest text-brand-orange">
        {t('fleet.kicker')}
      </span>
      <h2 data-reveal data-reveal-delay="0.05" class="mt-4 text-4xl md:text-5xl lg:text-6xl font-black text-white">
        {t('fleet.title')}
      </h2>
      <p data-reveal data-reveal-delay="0.1" class="mt-5 text-lg text-white/70 leading-relaxed">
        {t('fleet.subtitle')}
      </p>
    </div>

    <div data-fleet-grid class="mt-14 grid sm:grid-cols-2 xl:grid-cols-4 gap-5">
      {
        FLEET.map((jet) => {
          const waMsg = whatsappLink(t('common.whatsapp.model', { model: `${jet.brand} ${jet.model}` }));
          const thrillPct = (jet.thrill / 3) * 100;
          return (
            <article
              data-fleet-card
              class="group relative flex flex-col rounded-3xl border border-white/8 bg-ink-850/70 overflow-hidden transition-all duration-500 hover:border-brand-orange/40 hover:shadow-[0_30px_60px_-20px_rgba(0,0,0,0.7)]"
            >
              {/* Foto del modelo (render sobre blanco → zona de imagen blanca, look catálogo) */}
              <div class="relative aspect-[4/3] overflow-hidden bg-white flex items-center justify-center p-3">
                <img
                  src={jet.image}
                  alt={`${jet.brand} ${jet.model} — ${jet.power} CV`}
                  class="max-h-full max-w-full object-contain transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                  width="640"
                  height="480"
                />
                <span class="absolute top-3 left-3 rounded-full bg-ink-950/80 backdrop-blur px-3 py-1 text-xs font-semibold text-brand-sand-soft">
                  {jet.brand}
                </span>
                <span class="absolute top-3 right-3 rounded-full bg-brand-orange px-3 py-1 text-xs font-bold text-white">
                  {jet.power} {t('fleet.power')}
                </span>
              </div>

              {/* Cuerpo */}
              <div class="flex flex-col flex-1 p-5">
                <h3 class="text-xl font-bold text-white leading-tight">{jet.model}</h3>
                <p class="mt-2 text-sm text-white/55 leading-relaxed min-h-[2.5rem]">
                  {t(jet.tagKey as UIKey)}
                </p>

                {/* Medidor de adrenalina */}
                <div class="mt-4">
                  <div class="flex items-center justify-between text-[11px] uppercase tracking-wider text-white/40">
                    <span>{t(`fleet.thrill.${jet.thrill}` as UIKey)}</span>
                    <span>{jet.thrill}/3</span>
                  </div>
                  <div class="mt-1.5 h-1.5 rounded-full bg-white/10 overflow-hidden">
                    <div
                      data-thrill-fill={String(thrillPct)}
                      class="h-full rounded-full bg-gradient-to-r from-brand-sand to-brand-orange origin-left"
                      style={`transform:scaleX(${thrillPct / 100})`}
                    />
                  </div>
                </div>

                {/* Specs */}
                <div class="mt-4 flex items-center gap-4 text-sm text-white/60">
                  <span class="inline-flex items-center gap-1.5">
                    <Icon name="seat" class="w-4 h-4 text-brand-orange/80" />
                    {jet.seats} {t('fleet.seats')}
                  </span>
                  <span class="inline-flex items-center gap-1.5">
                    <Icon name="check" class="w-4 h-4 text-brand-orange/80" />
                    {jet.units} {t('fleet.units')}
                  </span>
                </div>

                {/* Precio + CTA */}
                <div class="mt-5 pt-5 border-t border-white/8 flex items-end justify-between gap-3">
                  <div>
                    <span class="block text-[11px] uppercase tracking-wider text-white/40">{t('fleet.from')}</span>
                    <span class="text-2xl font-display font-bold text-white">{fromPrice(jet)}€</span>
                  </div>
                  <a
                    href={waMsg}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-full bg-white/8 px-4 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:bg-brand-orange group-hover:bg-brand-orange"
                    aria-label={`${t('fleet.book')} — ${jet.model}`}
                  >
                    <Icon name="whatsapp" class="w-4 h-4" />
                    {t('nav.book')}
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>